# Google Places API — required for fetching live reviews
# 1. Go to https://console.cloud.google.com → APIs & Services → Enable "Places API (New)"
# 2. Create an API key, restrict it to "Places API (New)" + your domain
# 3. Find your Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id

GOOGLE_PLACES_API_KEY=your_api_key_here
GOOGLE_PLACE_ID=your_place_id_here
